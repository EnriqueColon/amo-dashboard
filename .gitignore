node_modules/
dist/
build/
.env
.env.local
collector/config.py
# All collector run logs. Generalised from individual entries: a noisy
# `git status` on the droplet is how a real problem hides — the untracked WAL
# files blocked a deploy for hours behind exactly that kind of noise.
collector/*.log

# PM2 config lives on the droplet and holds secrets; it must not be committed.
ecosystem.config.cjs
__pycache__/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/
.DS_Store
*.tsbuildinfo
collector/.venv/
collector/research/
collector/batch/

# Generated diagnostic reports (regenerable, DB-specific)
collector/tests/name_system_disagreements.tsv
collector/broward_collector.log
collector/broward_images.log
collector/broward_images/

# Nightly snapshots from collector/run_backup.sh. Note `*.db` above does NOT
# cover these — the archives are `.db.gz`, so without this line seven of them
# sit untracked on the droplet and make `git status` noisy again.
backups/
collector/backup.log
