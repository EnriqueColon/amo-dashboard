# Copy to .env (gitignored). On the droplet the live values are in
# /opt/amo-dashboard/.env and in PM2's held environment — after changing any of
# these run `pm2 restart amo-dashboard --update-env` (a plain restart keeps the
# old env; see ROLLBACK.md "Careful with PM2 here").

# ── Dashboard login ──────────────────────────────────────────────────────────
AMO_PASSWORD=
AMO_SECRET=

# ── Listen address ───────────────────────────────────────────────────────────
# Default: 127.0.0.1 when NODE_ENV=production (nginx on :80 is the only public
# entry point), 0.0.0.0 otherwise. Set 0.0.0.0 to expose Node directly again
# (rollback — docs/ops/close-port-5000.md). PM2 needs --update-env to see it.
AMO_BIND_HOST=

# ── Database ─────────────────────────────────────────────────────────────────
# Defaults to ./miami_dade_amo.db relative to the process cwd.
AMO_DB_PATH=

# ── Bank Stress Ranking / FDIC Data Analytics ────────────────────────────────
# Both pages read bank_stress.db, written weekly by collector/run_bank_stress.sh
# straight from the FDIC BankFind API (no key). Optional override of its path;
# the default is bank_stress.db next to AMO_DB_PATH.
# AMO_BANK_STRESS_DB_PATH=

# ── Ask the Data (chat assistant, POST /api/chat) ────────────────────────────
# OPENAI_API_KEY is the same key the collector uses (extract_pdfs.py); the Node
# server needs it too, so on the droplet it must be in PM2's held environment
# (`pm2 restart amo-dashboard --update-env`), not only in this file.
# Model defaults to gpt-6-astra ($10/M in, $50/M out). Cheaper alternative for
# routine use: gpt-6-sol. Reasoning effort: low|medium|high|xhigh|max|none.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_CHAT_REASONING_EFFORT=

# ── Weekly AMO Market Monitor email (Microsoft Graph) ────────────────────────
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
REPORT_SMTP_USER=
REPORT_RECIPIENTS=
