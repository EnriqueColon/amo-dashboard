# Copy to .env (gitignored). On the droplet the live values are in
# /opt/amo-dashboard/.env and in PM2's held environment — after changing any of
# these run `pm2 restart amo-dashboard --update-env` (a plain restart keeps the
# old env; see ROLLBACK.md "Careful with PM2 here").

# ── Dashboard login ──────────────────────────────────────────────────────────
AMO_PASSWORD=
AMO_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
# Defaults to ./miami_dade_amo.db relative to the process cwd.
AMO_DB_PATH=

# ── Market Intelligence (data source for the "FDIC Data Analytics" page) ─────
# Both required. Without them /api/mi/* returns 503 and the page shows
# "Market Intelligence unavailable". The key never reaches the browser.
MI_BASE_URL=
MI_ANALYTICS_API_KEY=

# ── Weekly AMO Market Monitor email (Microsoft Graph) ────────────────────────
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
REPORT_SMTP_USER=
REPORT_RECIPIENTS=
